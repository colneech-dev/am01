# Shell scripts must stay LF -- CRLF breaks them on Linux/WSL (bad
# shebang resolution, broken heredocs). This repo is checked out on
# Windows with core.autocrlf=true, which would otherwise convert them.
# Bit us repeatedly during hardware/qmtech-kintex7/openxc7/ bring-up and
# would bite hardware/qmtech-kintex7/cm4-firmware/setup-pi.sh the same
# way when fetched onto the Pi via curl | bash.
*.sh text eol=lf

# Same reasoning applies to Python scripts: a CRLF shebang line
# (#!/usr/bin/env python3) fails identically on Linux/WSL.
*.py text eol=lf

# The overlay's /usr/bin scripts have NO extension, so the *.sh rule above
# does not reach them, and they are shell scripts shipped into a Linux image.
# With core.autocrlf=true a fresh clone writes "#!/bin/sh\r" into every one of
# them and the built image dies with "bad interpreter: /bin/sh^M" -- silently,
# because all four are invoked by systemd units whose failure does not stop
# mining. Same failure this file's *.sh rule exists to prevent; the rule just
# never covered the files that had no extension.
hardware/qmtech-kintex7/linux/overlay/usr/bin/* text eol=lf
