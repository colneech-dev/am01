# Vivado drops these wherever it's invoked from, regardless of project
# directory -- catch them repo-wide rather than per-subdirectory.
.Xil/
retry_open_fs.log
webtalk*
*.jou
vivado*.log
vivado*.str

# Per-machine tool locations (see hardware/qmtech-kintex7/openxc7/toolchain.sh)
toolchain.local

# WiFi credentials for the CM4 miner -- keep the PSK out of the repo.
# Ships as a template; fill it in locally or on the running board.
hardware/qmtech-kintex7/linux/overlay/etc/wpa_supplicant/wpa_supplicant-wlan0.conf
hardware/qmtech-kintex7/openxc7/gen/

# Stray tool output dropped in the REPO ROOT by scripts invoked from here,
# rather than from the directory that owns them. Named specifically rather
# than as a blanket *.log, so a log someone deliberately commits still shows up.
n_*.log
build_*.log
