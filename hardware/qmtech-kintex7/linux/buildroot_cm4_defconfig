# AM01 Miner on Raspberry Pi Compute Module 4 (CM4), aarch64
#
# Build with the AM01 BR2_EXTERNAL tree, which supplies the odo-mining-stack
# package (odo-miner, odo-webd, odo-ui):
#
#   make BR2_EXTERNAL=<repo>/hardware/qmtech-kintex7/buildroot \
#        defconfig BR2_DEFCONFIG=<repo>/hardware/qmtech-kintex7/linux/buildroot_cm4_defconfig
#   make

# Architecture
BR2_aarch64=y
BR2_cortex_a72=y

# Toolchain
BR2_TOOLCHAIN_BUILDROOT=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# Kernel headers must be pinned to the Raspberry Pi kernel series below.
# The "custom kernel headers series" choice otherwise defaults to 2.6.x and
# the toolchain aborts with "expected 2.6.x, got 6.6.x".
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_6=y

# Kernel: the Raspberry Pi tree; mainline has no bcm2711 defconfig.
# BR2_LINUX_KERNEL_DEFCONFIG omits the _defconfig suffix -- Buildroot appends it.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/raspberrypi/linux/archive/refs/heads/rpi-6.6.y.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2711"
BR2_LINUX_KERNEL_IMAGE=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2711-rpi-cm4"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
# REQUIRED, not optional. The RPi kernel sets CONFIG_MODULE_COMPRESS_XZ, so
# every module ships as .ko.xz -- and kmod only links liblzma when
# BR2_PACKAGE_XZ is set (package/kmod/kmod.mk gates -Dxz=enabled on it).
# Without this, modprobe cannot decompress ANY module: they are all present
# under /usr/lib/modules and all unloadable. Symptom was no wlan0 at all,
# because brcmfmac could never load. Buildroot's own
# raspberrypicm4io_64_defconfig sets this.
BR2_PACKAGE_XZ=y
# And the HOST kmod needs it too, for a different reason: depmod runs on the
# build machine and must decompress each .ko.xz to read its symbols. Without
# it depmod silently emits an EMPTY modules.dep -- 0 bytes -- so modprobe
# reports "module not found" for modules that are sitting right there. Both
# options are required; either one alone leaves modules unloadable.
BR2_PACKAGE_HOST_KMOD_XZ=y

# Raspberry Pi boot firmware. Without this there is no start4.elf/fixup4.dat
# and the CM4 cannot boot at all.
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI4=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_AM01_PATH)/board/config.txt"

# rpiboot, to expose the CM4's eMMC as a USB block device for flashing.
# Built for the host, not the target: output/host/bin/rpiboot
BR2_PACKAGE_HOST_RASPBERRYPI_USBBOOT=y

# Filesystem: ext4 root for the image, plus the tarball for inspection.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="700M"
BR2_TARGET_ROOTFS_TAR_GZIP=y

# Assemble boot.vfat + rootfs.ext4 into a flashable sdcard.img
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_AM01_PATH)/board/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_AM01_PATH)/board/post-image.sh"

# System
BR2_TARGET_GENERIC_HOSTNAME="am01-miner"
# Empty on purpose. This is a *string* option (the banner text) -- it was set
# to "y", which made the banner literally "y". Buildroot writes /etc/issue from
# it during target-finalize and would clobber the overlay's version, which
# prints the eth0/wlan0 addresses above the login prompt via agetty's \4{iface}
# escapes. Leaving it empty stops Buildroot writing the file at all.
BR2_TARGET_GENERIC_ISSUE=""
BR2_TARGET_GENERIC_ROOT_PASSWD="changeme"
BR2_SYSTEM_BIN_SH_BASH=y

# Busybox
BR2_PACKAGE_BUSYBOX=y

# Essential utilities
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_GREP=y
BR2_PACKAGE_SED=y
BR2_PACKAGE_FINDUTILS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_WHICH=y
BR2_PACKAGE_SCREEN=y

# Networking. The board has a populated HR911130A RJ45 wired to the CM4's MDI
# pairs (manual section 2.2.9), so eth0 is real -- DHCP on it is the primary
# way in, since no pin-based serial console exists on this board.
# Empty on purpose: this generates a .network matching "eth0", which does not
# exist on this kernel (the interface is end0). The overlay ships
# 10-wired.network matching both names instead.
BR2_SYSTEM_DHCP=""
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_NETCAT=y
BR2_PACKAGE_WGET=y

# CM4 on-board WiFi: brcmfmac driver firmware plus a supplicant.
# Credentials are NOT in this repo; see /etc/wpa_supplicant.conf on the target.
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XX=y
# BCM43XXX carries the 43455 parts the CM4 needs: the Raspberry Pi nvram .txt
# and (via CYPRESS_CYW43XXX) the cyfmac43455 firmware and clm_blob. BCM43XX
# alone stops at 4354 and leaves the radio without firmware.
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XXX=y
# The wireless regulatory database. REQUIRED, not optional: the RPi kernel
# sets CONFIG_CFG80211_REQUIRE_SIGNED_REGDB, so without regulatory.db and its
# .p7s signature the country= setting in wpa_supplicant.conf can never apply.
# The regdomain stays at world (00), the firmware refuses the channel, and the
# driver reports "brcmf_set_channel fail" while wlan0 sits in SCANNING with
# the radio working perfectly.
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
# iw: needed to inspect or set the regulatory domain and to see association
# state at all -- and odo-ui shells out to it directly ("iw dev wlan0 link",
# "iw dev wlan0 scan"), so without it the UI's WiFi panel silently shows
# nothing even when the radio is working.
BR2_PACKAGE_IW=y
# procps-ng for pkill/pgrep. Busybox provides kill/killall/pidof but not
# these, which matters when hunting a stray process on the board.
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y

# Debugging
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_HTOP=y

# Diagnostics. Each of these was wanted during hardware bring-up and was not
# there, which turned a one-command answer into a guessing round:
#
#  lsof      -- "who is holding this device?" A stray gpioset held two bus
#               lines and made am01_bus_test fail with a message about
#               opening the chip. lsof /dev/gpiochip0 answers that instantly.
#  dtc       -- lets the RUNNING board be asked whether an overlay actually
#               applied: dtc -I fs -O dts /sys/firmware/devicetree/base.
#               am01-fpga-gpio has never been confirmed loaded on hardware.
#  usbutils  -- lsusb. Needed for the Pi-driven FPGA programming path: the
#               USB-Blaster has to enumerate on the board before
#               openFPGALoader can use it.
#  ethtool   -- link state and speed on end0. Distinguishes "no cable" from
#               "no DHCP", which we could not tell apart.
#  evtest    -- identifies which /dev/input/eventN is the touch panel, which
#               odo-ui needs and cannot discover for you.
#  iproute2  -- busybox's ip is a subset; ss and full ip route/addr matter
#               when the pool will not connect.
BR2_PACKAGE_LSOF=y
BR2_PACKAGE_DTC=y
BR2_PACKAGE_DTC_PROGRAMS=y
BR2_PACKAGE_USBUTILS=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_IPROUTE2=y

# NOTE: no rpi-userland / vcgencmd. The package was REMOVED from Buildroot
# (it is in Config.in.legacy now), and setting it aborts the entire build with
# "You have legacy configuration in your .config" -- which silently leaves the
# previous image in place, so the build looks like it succeeded until you
# check the artifact.
#
# The information it would have given is still reachable without it:
#   SoC temperature   /sys/class/thermal/thermal_zone0/temp
#   throttling flags  /sys/devices/platform/soc/soc:firmware/get_throttled
#                     (or the vcio ioctl)
# and the FPGA's own die temperature comes from am01_diag via XADC, which is
# the more relevant number here anyway.

# Hardware abstraction
BR2_PACKAGE_LIBGPIOD=y
BR2_PACKAGE_LIBGPIOD_TOOLS=y
BR2_PACKAGE_I2C_TOOLS=y

# FPGA programming over a USB-JTAG adapter attached to the CM4. Direct
# CM4-GPIO-to-J1 wiring is not viable on this board, so no libgpiod backend.
BR2_PACKAGE_OPENFPGALOADER=y

# JSON parsing
BR2_PACKAGE_JANSSON=y

# Systemd
BR2_INIT_SYSTEMD=y

# AM01 mining stack (pulls in libgpiod, libpng, freetype, fontconfig)
BR2_PACKAGE_ODO_MINING_STACK=y

# Rootfs overlay: systemd units and /etc/default templates
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_AM01_PATH)/../linux/overlay"
