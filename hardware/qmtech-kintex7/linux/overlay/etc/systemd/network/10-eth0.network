# Primary route in. BR2_SYSTEM_DHCP generates an equivalent file, but stating
# it here keeps eth0's policy next to wlan0's and makes the asymmetry explicit:
# eth0 IS required for network-online, wlan0 is not.
#
# With no cable plugged in, systemd-networkd-wait-online still waits its 120s
# timeout before boot continues. That is deliberate -- odo-miner needs a pool
# connection, and starting it into a dead network just burns its restart
# budget.

[Match]
Name=eth0

[Network]
DHCP=yes

[DHCPv4]
# Makes the miner easier to find on the LAN, since there is no mDNS.
SendHostname=yes
