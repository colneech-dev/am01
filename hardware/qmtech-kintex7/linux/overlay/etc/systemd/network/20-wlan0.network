# CM4 on-board WiFi. eth0 is configured by BR2_SYSTEM_DHCP; this covers wlan0.
# Association is handled by wpa_supplicant@wlan0, credentials in
# /etc/wpa_supplicant/wpa_supplicant-wlan0.conf (not in this repo).

[Match]
Name=wlan0

[Link]
# systemd-networkd-wait-online blocks until every managed link is configured,
# so an unassociated wlan0 held up boot for its full 120s timeout with
# "Waiting for network to be configured". WiFi is the secondary route in --
# eth0 is primary -- so it must not gate network-online.target.
RequiredForOnline=no

[Network]
DHCP=yes

[DHCPv4]
# Makes the miner easier to find on the LAN.
SendHostname=yes
