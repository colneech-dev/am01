[Unit]
Description=Watch for privileged requests from the CYD front panel
# The panel thread runs inside odo-miner as User=miner and cannot write /boot,
# /etc/wpa_supplicant or call systemctl. It drops a request file into
# /run/odod/request/ instead; this notices and starts the root-side helper.
Documentation=man:am01-panel-helper(8)

[Path]
# /run/odod is odo-miner.service's RuntimeDirectory (mode 0755, owned by
# miner), so the unprivileged side can create the request without any of it
# being writable by anyone else.
PathExistsGlob=/run/odod/request/*
# Re-arm immediately, so a second request queued while the first is being
# applied is not lost.
MakeDirectory=yes
DirectoryMode=0755

[Install]
WantedBy=multi-user.target
