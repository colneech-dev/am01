# AM01 OdoCrypt Mining Daemon (GPIO-connected FPGA variant)
#
#   systemctl status odo-miner
#   journalctl -u odo-miner -f
#
# Pool and wallet live in /etc/default/odo-miner.

[Unit]
Description=AM01 OdoCrypt Mining Daemon (GPIO FPGA)
Documentation=https://github.com/colneech-dev/am01
After=network-online.target local-fs.target am01-fpga.service
Wants=network-online.target
# Wants, not Requires: when the FPGA is programmed externally over JTAG,
# am01-fpga.service is skipped and the miner should still start.
Wants=am01-fpga.service
# StartLimit* belong in [Unit]; systemd ignores them in [Service].
#
# Rate limiting disabled deliberately. With the default burst the miner would
# fail 5 times in 60s against an unreachable pool and then stay dead until
# someone intervened -- exactly wrong for an unattended miner, where the pool
# or the network being down is a transient condition to sit through, not a
# reason to stop. RestartSec caps the retry rate instead.
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=-/etc/default/odo-miner

# These must be literal. systemd does not expand environment variables in
# User=/Group=/WorkingDirectory=, and supports no shell-style ${VAR:-default}
# syntax anywhere -- an earlier version of this unit used both and could
# never have started.
User=miner
Group=miner
# Read/write access to /dev/gpiochip* for the FPGA bus.
SupplementaryGroups=gpio
WorkingDirectory=/var/lib/odo-miner

# The program in ExecStart= must be a literal absolute path; only arguments
# may come from the environment. Unbraced $DAEMON_OPTS is split on whitespace
# into separate arguments, which ${DAEMON_OPTS} would not do.
ExecStart=/usr/bin/odo-miner $DAEMON_OPTS

# /run/odod, where odo-webd and odo-ui read status from, and
# /run/odod/request, where the panel drops privileged requests for
# am01-panel-helper.path to pick up.
#
# BOTH LISTED, so systemd creates them owned by the service user. The request
# directory used to be created by the daemon itself on first use -- which
# worked until something running as root created it first, after which the
# miner could not write into its own request directory and every panel action
# failed with EACCES. Ownership is not something to leave to whoever gets
# there first.
RuntimeDirectory=odod odod/request
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

# /var/lib/odod, where the all-time best difficulty and block count live.
#
# THIS WAS MISSING, and stats_save() failed on every write from the day it was
# written: nothing created the directory, the miner runs as User=miner so it
# could not create it itself, and the failure path was a bare `return`. The
# symptom was BEST-A resetting on every restart, which reads as a miner that
# forgets rather than a directory that is not there.
#
# StateDirectory=, not a tmpfiles rule: systemd creates it owned by the
# service user before ExecStart, which is exactly the guarantee wanted.
StateDirectory=odod
StateDirectoryMode=0755

Restart=on-failure
# 30s, not 5: the usual reason for a restart is the pool or the network being
# unreachable, and hammering it every 5 seconds helps nobody.
RestartSec=30

Nice=5
IOSchedulingClass=2
IOSchedulingPriority=4
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=odo-miner

KillMode=control-group
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
