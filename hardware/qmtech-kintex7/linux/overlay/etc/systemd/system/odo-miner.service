# AM01 OdoCrypt Mining Daemon (GPIO-connected FPGA variant)
#
#   systemctl status odo-miner
#   journalctl -u odo-miner -f
#
# Pool and wallet live in /etc/default/odo-miner.

[Unit]
Description=AM01 OdoCrypt Mining Daemon (GPIO FPGA)
Documentation=https://github.com/colneech-dev/am01
After=network-online.target local-fs.target am01-fpga.service
Wants=network-online.target
# Wants, not Requires: when the FPGA is programmed externally over JTAG,
# am01-fpga.service is skipped and the miner should still start.
Wants=am01-fpga.service
# StartLimit* belong in [Unit]; systemd ignores them in [Service].
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=-/etc/default/odo-miner

# These must be literal. systemd does not expand environment variables in
# User=/Group=/WorkingDirectory=, and supports no shell-style ${VAR:-default}
# syntax anywhere -- an earlier version of this unit used both and could
# never have started.
User=miner
Group=miner
# Read/write access to /dev/gpiochip* for the FPGA bus.
SupplementaryGroups=gpio
WorkingDirectory=/var/lib/odo-miner

# The program in ExecStart= must be a literal absolute path; only arguments
# may come from the environment. Unbraced $DAEMON_OPTS is split on whitespace
# into separate arguments, which ${DAEMON_OPTS} would not do.
ExecStart=/usr/bin/odo-miner $DAEMON_OPTS

# /run/odod, where odo-webd and odo-ui read status from.
RuntimeDirectory=odod
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

Restart=on-failure
RestartSec=5

Nice=5
IOSchedulingClass=2
IOSchedulingPriority=4
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=odo-miner

KillMode=control-group
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
