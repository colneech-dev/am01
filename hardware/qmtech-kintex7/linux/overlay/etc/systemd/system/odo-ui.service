# AM01 touch screen UI
#
# Needs a framebuffer and a touch input device. With no display attached this
# unit is skipped rather than failed, via ConditionPathExists below; use
# odo-webd instead. To stop it being tried at all:
#
#   systemctl disable odo-ui
#
# Device paths live in /etc/default/odo-ui.

[Unit]
Description=AM01 Touch Screen UI
Documentation=https://github.com/colneech-dev/am01
After=odo-miner.service
# No framebuffer -> skipped as a no-op, not a boot failure.
ConditionPathExists=/dev/fb0
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=-/etc/default/odo-ui

# root: needs /dev/fb0 and /dev/input/event*. Literal, not variables --
# see the note in odo-miner.service.
User=root
Group=root
WorkingDirectory=/var/lib/odo-miner

ExecStart=/usr/bin/odo-ui $UI_OPTS

Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=odo-ui

[Install]
WantedBy=multi-user.target
