# AM01 OdoCrypt Touch Screen UI
#
# Renders mining dashboard on /dev/fb0 (framebuffer)
# Requires: framebuffer device, touch input (e.g., /dev/input/event0)
# Depends on odo-miner and odo-webd for status data

[Unit]
Description=AM01 Touch Screen Dashboard UI
Documentation=https://github.com/colneech-dev/am01
After=network-online.target local-fs.target odo-miner.service odo-webd.service
BindsTo=odo-miner.service
Wants=odo-webd.service

[Service]
Type=simple

# Configuration
EnvironmentFile=-/etc/default/odo-ui

# Run as user with access to framebuffer and input devices
User=${UI_USER:-root}
Group=${UI_GROUP:-root}

# Working directory
WorkingDirectory=${UI_DIR:-/opt/odo-ui}

# Binary
ExecStart=${UI_BIN:-/usr/local/bin/odo-ui} ${UI_OPTS:--fb /dev/fb0 -touch /dev/input/event0}

# Restart on failure
Restart=on-failure
RestartSec=2

# Resource limits
Nice=5
LimitNOFILE=2048

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=odo-ui

# Shutdown behavior
KillMode=mixed
TimeoutStopSec=5

[Install]
WantedBy=graphical.target multi-user.target
