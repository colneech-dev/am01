#!/bin/sh
#
# am01-panel-helper -- carry out the front panel's privileged requests.
#
# THIS FILE IS THE PRIVILEGE BOUNDARY. Treat every byte it reads as hostile.
#
# WHY IT EXISTS. odo-miner runs User=miner (odo-miner.service), and the CYD
# panel thread lives inside it. So the panel could never actually do the things
# its menu offered: /boot is root-owned vfat, /etc/wpa_supplicant is root-owned,
# and systemctl needs root. Pool, WiFi, reboot and restart all failed silently
# -- the panel drew the buttons, the daemon logged one line to stderr, and
# nothing happened. Four buttons that lie are worse than four buttons that are
# greyed out.
#
# WHY NOT THE OBVIOUS FIXES.
#   - Running odo-miner as root would hand root to the whole mining daemon,
#     including its network-facing stratum client, to fix four buttons.
#   - setuid on a helper means writing a C program that is safe with an
#     attacker-controlled environment. More rope than this needs.
#   - sudo is not in the image.
#
# So: the panel writes a REQUEST FILE into /run/odod/request/ (already writable
# by miner -- RuntimeDirectory=odod), a systemd .path unit notices, and this
# runs as root and decides whether to obey. The unprivileged side can ask; only
# this side can act.
#
# THE VALIDATION BELOW IS THE WHOLE POINT. Anything that reaches /run/odod/
# already has the miner account, and this turns that into root if it is sloppy.
# Every field is checked against an allow-list of characters, never a deny-list,
# and anything unrecognised is dropped rather than guessed at.
#
# REQUEST FORMAT -- one file per request, named for the verb, LINE ORIENTED so
# no delimiter can be smuggled inside a field:
#
#   reboot     (empty)
#   restart    (empty)
#   set_pool   host \n port \n worker \n pass
#   set_wifi   ssid \n psk
#
set -u

REQ_DIR=/run/odod/request
POOL_CONF=/boot/am01-miner.conf
WPA_CONF=/etc/wpa_supplicant/wpa_supplicant-wlan0.conf
# THE ONE THAT SURVIVES. am01-wifi-provision.service copies this over
# WPA_CONF before am01-wifi.service starts, on every boot -- so writing
# only WPA_CONF applies a change now and loses it at the next restart.
WPA_BOOT=/boot/wpa_supplicant.conf
WIFI_COUNTRY=GB
SCAN_PATH=/run/odod/wifi_scan.txt

# WHERE ROOT STAGES FILES BEFORE PUBLISHING THEM.
#
# NOT under /run/odod. That directory is created by odo-miner.service as
# RuntimeDirectory=odod and is owned by `miner`, so anything running as the
# miner -- including the daemon holding the pool connection -- can create
# paths inside it. This script runs as root, and a plain `> $file` redirect
# follows a symlink and truncates whatever it points at. Staging the scan at
# /run/odod/wifi_scan.txt.tmp therefore handed any miner-uid process an
# arbitrary root-owned file overwrite: pre-create that name as a link to
# /etc/shadow or /root/.ssh/authorized_keys, press SCAN, and root does the
# write. The `mv` afterwards even removed the evidence.
#
# /run is root-owned and mode 0755, so only root can create this directory,
# and 0700 keeps its contents unreadable to everyone else while a file is
# half-written.
#
# The PUBLISH step was never the hole and does not change: mv uses rename(2),
# which replaces a symlink at the destination rather than following it. Both
# paths are on the same tmpfs, so it stays a rename and never degrades to a
# copy (which would follow the link).
STAGE_DIR=/run/am01-panel-helper

say()  { echo "am01-panel-helper: $*" >&2; }
deny() { say "REFUSED $1: $2"; }

# Allow-lists. `case` globs, so no regex engine and no surprises.
ok_host()   { case "$1" in ''|*[!A-Za-z0-9.-]*) return 1;; esac; [ ${#1} -le 63 ]; }
ok_port()   { case "$1" in ''|*[!0-9]*) return 1;; esac
              [ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 65535 ]; }
ok_worker() { case "$1" in ''|*[!A-Za-z0-9._-]*) return 1;; esac; [ ${#1} -le 95 ]; }
# The pool password is conventionally "x" and is not a secret, but it still
# lands in a shell-quoted DAEMON_OPTS line, so no quotes, no backslashes, no
# spaces.
ok_pass()   { case "$1" in ''|*[!A-Za-z0-9._-]*) return 1;; esac; [ ${#1} -le 31 ]; }
# SSIDs may contain spaces. They may NOT contain the two characters that would
# break out of ssid="..." in wpa_supplicant.conf.
ok_ssid()   { case "$1" in ''|*'"'*|*'\'*) return 1;; esac; [ ${#1} -le 32 ]; }
# WPA2: 8..63 characters, same quoting rule.
ok_psk()    { case "$1" in *'"'*|*'\'*) return 1;; esac
              [ ${#1} -ge 8 ] && [ ${#1} -le 63 ]; }

# Read line N of a file, with no interpretation of backslashes and no trailing
# newline surprises. `read -r` leaves the field exactly as written.
line_of() { sed -n "${2}p" "$1" | tr -d '\r'; }

apply_set_pool() {
	f=$1
	host=$(line_of "$f" 1); port=$(line_of "$f" 2)
	worker=$(line_of "$f" 3); pass=$(line_of "$f" 4)

	ok_host   "$host"   || { deny set_pool "host";   return; }
	ok_port   "$port"   || { deny set_pool "port";   return; }
	ok_worker "$worker" || { deny set_pool "worker"; return; }
	ok_pass   "$pass"   || { deny set_pool "pass";   return; }

	# DAEMON_OPTS is the ONLY key anything reads: am01-miner-provision.service
	# requires ^DAEMON_OPTS= and ignores the file otherwise. odo-miner takes
	# positional arguments -- its main() has no option parser at all.
	tmp="${POOL_CONF}.tmp"
	# umask IN A SUBSHELL. Set bare, it outlives this function -- there is no
	# restore, and every error path below returns before one could run. The
	# dispatch loop handles a sorted glob in one invocation, and `wifi_scan`
	# sorts after `set_pool` and `set_wifi`, so the leak reached the scan
	# result and left it 0600 root-owned for a panel running as `miner`.
	(
		umask 077
		{
			echo "# written by the CYD front panel"
			echo "DAEMON_OPTS=\"$host $port $worker $pass\""
		} > "$tmp"
	) || { deny set_pool "cannot write $tmp"; return; }
	sync
	mv -f "$tmp" "$POOL_CONF" || { deny set_pool "rename failed"; rm -f "$tmp"; return; }
	sync
	say "pool set to $host:$port worker $worker"
}

# Scan for networks and leave the result where the panel thread can read it.
#
# NEEDS ROOT, which is the only reason it is here: SIOCSIWSCAN wants
# CAP_NET_ADMIN and odo-miner runs as User=miner. Nothing here takes an
# argument -- `iw` is invoked with a fixed command line, so there is no user
# input to validate and no way for a request to influence what runs.
#
# `iw`, not `wpa_cli`: this image's wpa_supplicant is started without a
# ctrl_interface, so /var/run/wpa_supplicant is empty and wpa_cli has nothing
# to connect to. iw talks to nl80211 directly.
#
# A scan briefly takes the radio off-channel. That is a few hundred
# milliseconds of a link that is not carrying the mining connection anyway --
# the miner is on ethernet here -- and it is only ever triggered by someone
# standing at the panel pressing SCAN.
apply_wifi_scan() {
	mkdir -p "$STAGE_DIR" || { deny wifi_scan "cannot create $STAGE_DIR"; return; }
	chmod 0700 "$STAGE_DIR"
	out=$STAGE_DIR/wifi_scan.txt

	# Strongest first, one entry per SSID, hidden networks dropped.
	#
	# The signal line precedes the SSID line for each BSS, so the awk holds
	# the last signal seen and emits it when the SSID arrives. sort -rn puts
	# the least-negative dBm first, and the dedupe keeps whichever came
	# first -- which, after the sort, is the strongest of a repeated SSID.
	# That matters: mesh and band-steering setups advertise one name from
	# several radios.
	iw dev wlan0 scan 2>/dev/null | awk '
		/^BSS /       { sig = "" }
		/signal:/     { sig = $2 }
		/^\tSSID: /   { ssid = substr($0, 8)
		                if (ssid != "" && sig != "") print sig "\t" ssid }
	' | sort -rn | awk -F'\t' '
		# HIDDEN NETWORKS OUT. iw renders a cloaked SSID as a run of
		# \\x00 escapes. It is not a name, and picking it off a
		# list cannot join anything.
		$2 ~ /\\x00/ { next }
		{
			ssid = $2
			# Anything else iw escaped is non-ASCII -- a smart quote,
			# an emoji. The panel draws an ASCII bitmap font, so show
			# a placeholder rather than a literal backslash-x-e-2.
			gsub(/\\x[0-9a-fA-F][0-9a-fA-F]/, "?", ssid)
			if (!seen[ssid]++) print $1 "\t" ssid
		}
	' | head -n 12 > "$out" 2>/dev/null

	if [ ! -s "$out" ]; then
		# An empty result is still a result -- the panel must be told the
		# scan finished, or it waits for a list that is never coming.
		: > "$out"
		say "wifi scan found nothing"
	else
		say "wifi scan found $(wc -l < "$out") network(s)"
	fi
	# EXPLICIT MODE, not whatever umask happens to be in force.
	#
	# apply_set_pool and apply_set_wifi both set `umask 077` and neither
	# restores it, and the dispatch loop processes a sorted glob in which
	# wifi_scan always sorts last -- so a scan queued behind a pool change is
	# handled by the same invocation and inherits that umask. The file then
	# lands 0600 root-owned, the panel thread (running as miner) gets EACCES
	# from fopen(), and it waits out its 20s timeout and reports no networks.
	# Standalone the identical scan works, because the service umask is 0022.
	chmod 0644 "$out" || { deny wifi_scan "cannot chmod result"; rm -f "$out"; return; }
	mv -f "$out" "$SCAN_PATH"
}

apply_set_wifi() {
	f=$1
	ssid=$(line_of "$f" 1); psk=$(line_of "$f" 2)

	ok_ssid "$ssid" || { deny set_wifi "ssid"; return; }
	ok_psk  "$psk"  || { deny set_wifi "psk";  return; }

	tmp="${WPA_CONF}.tmp"
	# 0600 at creation; this file holds a PSK.
	# umask IN A SUBSHELL. Set bare, it outlives this function -- there is no
	# restore, and every error path below returns before one could run. The
	# dispatch loop handles a sorted glob in one invocation, and `wifi_scan`
	# sorts after `set_pool` and `set_wifi`, so the leak reached the scan
	# result and left it 0600 root-owned for a panel running as `miner`.
	(
		umask 077
		{
			echo "# written by the CYD front panel"
			echo "ctrl_interface=/var/run/wpa_supplicant"
			echo "update_config=1"
			# country= is NOT optional: without it the regdomain stays at
			# world (00), the firmware refuses the channel, and wlan0 sits
			# in SCANNING with the radio working perfectly.
			echo "country=$WIFI_COUNTRY"
			echo "network={"
			echo "	ssid=\"$ssid\""
			echo "	key_mgmt=WPA-PSK"
			echo "	psk=\"$psk\""
			echo "}"
		} > "$tmp"
	) || { deny set_wifi "cannot write $tmp"; return; }
	sync
	mv -f "$tmp" "$WPA_CONF" || { deny set_wifi "rename failed"; rm -f "$tmp"; return; }
	sync

	# AND THE COPY THAT SURVIVES A REBOOT.
	#
	# Writing only /etc looked like it worked -- the change applied, wlan0
	# associated -- and then am01-wifi-provision.service copied
	# /boot/wpa_supplicant.conf back over it on the next boot and the old
	# network returned with nothing to explain it. /boot is the source of
	# truth, the same way /boot/am01-miner.conf is for the pool.
	#
	# Failure here is reported but NOT fatal: the running configuration is
	# already correct, and "your change works until you reboot" is worth
	# saying out loud rather than discarding a change that did apply.
	if [ -d /boot ]; then
		btmp="${WPA_BOOT}.tmp"
		if cp -f "$WPA_CONF" "$btmp" 2>/dev/null && \
		   mv -f "$btmp" "$WPA_BOOT" 2>/dev/null; then
			sync
		else
			rm -f "$btmp" 2>/dev/null
			say "WARNING: could not write $WPA_BOOT -- this change will be"
			say "         reverted at the next boot by am01-wifi-provision"
		fi
	fi
	# SSID only. The PSK is never logged.
	say "wifi configured for SSID \"$ssid\""
	# am01-wifi.service, not wpa_supplicant@wlan0 -- this image runs its own
	# unit, and the distro template is not masked, so starting it would put a
	# SECOND supplicant on wlan0.
	systemctl restart am01-wifi.service || say "am01-wifi restart failed; applies at next boot"
}

[ -d "$REQ_DIR" ] || exit 0

for f in "$REQ_DIR"/*; do
	[ -f "$f" ] || continue
	verb=$(basename "$f")
	case "$verb" in
	reboot)
		rm -f "$f"
		say "REBOOT requested from the front panel"
		sync
		systemctl reboot
		;;
	restart)
		rm -f "$f"
		say "miner restart requested from the front panel"
		# --no-block: the requester is a thread inside the unit being
		# restarted, and a blocking restart waits for a stop that cannot
		# finish until this returns.
		systemctl --no-block restart odo-miner
		;;
	set_pool)
		apply_set_pool "$f"; rm -f "$f"
		;;
	wifi_scan)
		rm -f "$f"
		apply_wifi_scan
		;;
	set_wifi)
		# Removed FIRST, so a malformed request cannot be retried forever by
		# the path unit re-triggering on a file that never goes away.
		cp "$f" "$f.work" 2>/dev/null && rm -f "$f"
		apply_set_wifi "$f.work"; rm -f "$f.work"
		;;
	*)
		rm -f "$f"
		say "REFUSED unknown request: $verb"
		;;
	esac
done
