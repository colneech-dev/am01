     PlacerHeapCfg cfg;
 
     int max_x = 0, max_y = 0;
+
+    // Per-tile general-routing capacity, in wires, plus the mean over tiles
+    // that have any. Device geometry rather than placement state, so it is
+    // built once and reused for every spread.
+    //
+    // Deliberately uses the SAME wire-location rule as the router -- the
+    // midpoint of the wire's route bounding box, see setup_wires() in
+    // common/router2.cc -- so that a demand figure computed here and an
+    // overuse figure measured there refer to the same tile by construction,
+    // rather than by coincidence of two independently-chosen binning schemes.
+    //
+    // Nothing in this flow computed capacity before. Without the denominator,
+    // the RUDY demand estimate in CutSpreader can only be compared against an
+    // absolute constant (NEXTPNR_WIRE_DEMAND), which does not transfer between
+    // designs or devices: a sweep on one design found a narrow optimum, with
+    // half and double the best value both clearly worse.
+    std::vector<std::vector<float>> route_capacity;
+    float route_capacity_mean = 0.0f;
+
+    void build_route_capacity()
+    {
+        if (!route_capacity.empty())
+            return;
+        route_capacity.assign(max_x + 1, std::vector<float>(max_y + 1, 0.0f));
+        for (auto wire : ctx->getWires()) {
+            ArcBounds wl = ctx->getRouteBoundingBox(wire, wire);
+            int x = (wl.x0 + wl.x1) / 2, y = (wl.y0 + wl.y1) / 2;
+            if (x < 0 || y < 0 || x > max_x || y > max_y)
+                continue;
+            route_capacity.at(x).at(y) += 1.0f;
+        }
+        double total = 0;
+        int nonzero = 0;
+        for (int x = 0; x <= max_x; x++)
+            for (int y = 0; y <= max_y; y++)
+                if (route_capacity.at(x).at(y) > 0.0f) {
+                    total += route_capacity.at(x).at(y);
+                    ++nonzero;
+                }
+        route_capacity_mean = nonzero ? float(total / nonzero) : 0.0f;
+        log_info("routing capacity: %d tiles carry wires, mean %.1f wires/tile\n", nonzero,
+                 double(route_capacity_mean));
+    }
+
