             }
         }
 
+        // Congestion ratio at a tile: estimated routing demand over real
+        // routing capacity. Returns 1.0 (neutral) when the estimate or the
+        // capacity map is unavailable, so callers may multiply by it
+        // unconditionally.
+        float cong_at(int x, int y)
+        {
+            if (wire_demand.empty() || p->route_capacity.empty())
+                return 1.0f;
+            if (x < 0 || y < 0 || x > p->max_x || y > p->max_y)
+                return 1.0f;
+            float cap = p->route_capacity.at(x).at(y);
+            if (!(cap > 0.0f))
+                cap = p->route_capacity_mean; // tile has no wires of its own
+            if (!(cap > 0.0f))
+                return 1.0f;
+            return wire_demand.at(x).at(y) / cap;
+        }
+
+        // Worst congestion over a region's extent. Used as the region's
+        // density-target multiplier, so a region is judged by its hottest
+        // tile rather than by an average that a large cool area would dilute.
+        float cong_max(int x0, int y0, int x1, int y1)
+        {
+            float m = 1.0f;
+            if (wire_demand.empty() || p->route_capacity.empty())
+                return m;
+            for (int x = std::max(0, x0); x <= std::min(p->max_x, x1); x++)
+                for (int y = std::max(0, y0); y <= std::min(p->max_y, y1); y++)
+                    m = std::max(m, cong_at(x, y));
+            return m;
+        }
+
         bool wire_congested(int x, int y)
         {
             if (wire_demand.empty())
                 return false;
+            // Capacity-relative mode: congested when demand exceeds a fraction
+            // of what the tile can actually carry.
+            if (cong_ratio() > 0.0f)
+                return cong_at(x, y) > cong_ratio();
             return wire_demand.at(x).at(y) > wire_demand_cap;
         }
 
