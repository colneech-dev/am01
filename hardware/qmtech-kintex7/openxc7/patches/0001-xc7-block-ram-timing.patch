diff --git a/xilinx/arch.cc b/xilinx/arch.cc
index 5a061c9..5b57009 100644
--- a/xilinx/arch.cc
+++ b/xilinx/arch.cc
@@ -20,6 +20,7 @@
 
 #include <algorithm>
 #include <boost/algorithm/string.hpp>
+#include "xc7_bram_timing.h"
 #include <boost/range/adaptor/reversed.hpp>
 #include <cmath>
 #include <cstring>
@@ -1261,6 +1262,30 @@ TimingPortClass Arch::getPortTimingClass(const CellInfo *cell, IdString port, in
             return TMG_COMB_INPUT;
         if (port == id_O)
             return TMG_COMB_OUTPUT;
+    } else if (cell->type.in(id_RAMB18E1_RAMB18E1, id_RAMB36E1_RAMB36E1)) {
+        // Block RAM was absent from this function entirely, so every RAMB
+        // port fell through to TMG_IGNORE below. That silently removed
+        // block RAM from timing analysis: a BRAM output was not a start
+        // point, its address inputs were not endpoints, and any critical
+        // path through a memory was invisible. On a BRAM-heavy design the
+        // reported Fmax was then just the worst LUT-to-LUT path -- wrong,
+        // and optimistic. See openxc7/README.md in the AM01 repo.
+        const std::string p = port.str(this);
+        if (p == "CLKARDCLK" || p == "CLKBWRCLK")
+            return TMG_CLOCK_INPUT;
+        if (boost::starts_with(p, "DOADO") || boost::starts_with(p, "DOBDO") ||
+            boost::starts_with(p, "DOPADOP") || boost::starts_with(p, "DOPBDOP")) {
+            clockInfoCount = 1;
+            return TMG_REGISTER_OUTPUT;
+        }
+        if (boost::starts_with(p, "ADDR") || boost::starts_with(p, "DIADI") ||
+            boost::starts_with(p, "DIBDI") || boost::starts_with(p, "DIPADIP") ||
+            boost::starts_with(p, "DIPBDIP") || boost::starts_with(p, "WE") ||
+            boost::starts_with(p, "EN") || boost::starts_with(p, "REGCE")) {
+            clockInfoCount = 1;
+            return TMG_REGISTER_INPUT;
+        }
+        return TMG_IGNORE; // RST*, cascade and config pins
     }
     return TMG_IGNORE;
 }
@@ -1273,6 +1298,28 @@ TimingClockingInfo Arch::getPortClockingInfo(const CellInfo *cell, IdString port
     info.clockToQ = DelayQuad(getDelayFromNS(0.1));
     info.clock_port = xc7 ? id_CK : id_CLK;
     info.edge = RISING_EDGE;
+
+    if (cell->type.in(id_RAMB18E1_RAMB18E1, id_RAMB36E1_RAMB36E1)) {
+        // Numbers come from xc7_bram_timing.h, generated by
+        // tools/make_bram_timing.py out of prjxray's SDF -- not hand-typed
+        // here, so regenerating against better source data updates them.
+        const std::string p = port.str(this);
+        const bool b_side = boost::starts_with(p, "DOBDO") || boost::starts_with(p, "DOPBDOP") ||
+                            boost::starts_with(p, "ADDRBWRADDR") || boost::starts_with(p, "DIBDI") ||
+                            boost::starts_with(p, "DIPBDIP") || boost::starts_with(p, "WEBWE") ||
+                            boost::starts_with(p, "ENBWREN") || boost::starts_with(p, "REGCEB");
+        info.clock_port = b_side ? id("CLKBWRCLK") : id("CLKARDCLK");
+        // Without the optional output register (DO_REG=0, what a plain
+        // `q <= mem[addr]` infers) the read comes off the latch and is
+        // roughly 2.8x slower than the registered path the 458MHz
+        // FMAX_BRAM rating assumes.
+        const bool reg_out = b_side ? bool_or_default(cell->params, id("DOB_REG"), false)
+                                    : bool_or_default(cell->params, id("DOA_REG"), false);
+        info.clockToQ = DelayQuad(getDelayFromNS(reg_out ? XC7_BRAM_CLK_TO_DO_REG_NS
+                                                         : XC7_BRAM_CLK_TO_DO_NS));
+        info.setup = DelayPair(getDelayFromNS(XC7_BRAM_ADDR_SETUP_NS));
+        info.hold = DelayPair(getDelayFromNS(XC7_BRAM_ADDR_HOLD_NS));
+    }
     return info;
 }
 
