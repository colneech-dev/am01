+// Apply region constraints carried in the design file.
+//
+// nextpnr has had a Region API for a long time (createRectangularRegion,
+// constrainCellToRegion) but no way to express one from JSON, so the only route
+// was a --pre-place Python script. Python bindings are a build option, so a
+// floorplan built that way cannot run on a stock nextpnr at all. This reads the
+// same information from attributes, mirroring how the BEL attribute already
+// pins a cell to a site -- REGION is the same idea one level coarser.
+//
+//   design attr:  nextpnr_regions = "name:x0,y0,x1,y1;name2:..."
+//   cell attr:    REGION          = "name"
+//
+// Malformed entries are reported and skipped rather than aborting: a floorplan
+// is an optimisation hint, and refusing to run at all because one box is
+// mistyped would be a poor trade.
+void apply_region_constraints(Context *ctx)
+{
+    auto defs = ctx->attrs.find(ctx->id("nextpnr_regions"));
+    if (defs == ctx->attrs.end())
+        return;
+
+    std::string spec = defs->second.as_string();
+    int created = 0, bad = 0;
+    size_t pos = 0;
+    while (pos < spec.size()) {
+        size_t end = spec.find(';', pos);
+        if (end == std::string::npos)
+            end = spec.size();
+        std::string entry = spec.substr(pos, end - pos);
+        pos = end + 1;
+        if (entry.empty())
+            continue;
+        size_t colon = entry.find(':');
+        if (colon == std::string::npos) {
+            ++bad;
+            continue;
+        }
+        std::string name = entry.substr(0, colon);
+        int v[4];
+        // Parse exactly four comma-separated integers; anything else is a
+        // malformed box and is skipped rather than half-applied.
+        if (std::sscanf(entry.c_str() + colon + 1, "%d,%d,%d,%d", &v[0], &v[1], &v[2], &v[3]) != 4) {
+            ++bad;
+            continue;
+        }
+        ctx->createRectangularRegion(ctx->id(name), v[0], v[1], v[2], v[3]);
+        ++created;
+    }
+
+    int constrained = 0, missing = 0;
+    for (auto &cell_entry : ctx->cells) {
+        CellInfo *cell = cell_entry.second.get();
+        auto it = cell->attrs.find(ctx->id("REGION"));
+        if (it == cell->attrs.end())
+            continue;
+        IdString rname = ctx->id(it->second.as_string());
+        if (!ctx->region.count(rname)) {
+            ++missing;
+            continue;
+        }
+        ctx->constrainCellToRegion(cell->name, rname);
+        ++constrained;
+    }
+
+    log_info("Applied %d region(s) from design attributes, constraining %d cell(s).\n", created, constrained);
+    if (bad)
+        log_warning("  %d malformed entr(ies) in nextpnr_regions were skipped.\n", bad);
+    if (missing)
+        log_warning("  %d cell(s) name a REGION that was never defined.\n", missing);
+}
+
 NEXTPNR_NAMESPACE_END
