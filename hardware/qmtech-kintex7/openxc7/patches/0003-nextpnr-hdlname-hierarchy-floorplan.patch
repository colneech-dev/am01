+// Apply region constraints declared in the design file:
+//   design attr  nextpnr_regions = "name:x0,y0,x1,y1;..."
+//   cell attr    REGION          = "name"
+// Lets a floorplan travel in the JSON instead of requiring a --pre-place
+// Python script, which needs bindings that are only a build option.
+void apply_region_constraints(Context *ctx);
+
+// Derive a floorplan from yosys hdlname attributes: group cells by RTL
+// scope at an automatically chosen depth, and confine each group to a region
+// around whichever of its cells are already placed. Requires a yosys that
+// preserves hdlname through synthesis.
+void derive_hierarchy_floorplan(Context *ctx, int pad = 30, double max_frac = 0.10, int min_cells = 64);
+
