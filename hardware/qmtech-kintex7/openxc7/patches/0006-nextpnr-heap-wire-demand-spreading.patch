+                // Skip global/clock nets: they ride dedicated resources, and
+                // spreading their bounding box over the die would mark
+                // everything congested. High fanout is the portable proxy --
+                // there is no arch-neutral "is this a global net" query.
+                if (int(ni->users.size()) > 256)
