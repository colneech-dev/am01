+        // Estimate routing demand with RUDY: every net spreads its half-perimeter
+        // uniformly across its own bounding box. A net whose bbox is tight
+        // therefore loads those few tiles heavily, which is exactly the case that
+        // makes a locally-dense placement unroutable while BEL occupancy stays
+        // low.
+        void build_wire_demand()
+        {
+            const char *v = getenv("NEXTPNR_WIRE_DEMAND");
+            if (v == nullptr)
+                return;
+            wire_demand_cap = float(atof(v));
+            if (!(wire_demand_cap > 0.0f))
+                return;
+            wire_demand.assign(p->max_x + 1, std::vector<float>(p->max_y + 1, 0.0f));
+            for (auto &net_entry : p->ctx->nets) {
+                NetInfo *ni = net_entry.second.get();
+                if (ni->driver.cell == nullptr)
+                    continue;
+                if (ni->users.empty())
