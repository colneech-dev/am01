+// True if this net rides dedicated global routing rather than the general
+// fabric. The condition is the driver being a global buffer output; the global
+// router's other cases (PLL/MMCM feeds, IBUFDS->BUFG inputs) concern which nets
+// it must route through the dedicated backbone, not which nets consume general
+// routing, so they are deliberately not folded in here.
+bool Arch::isGlobalNet(const NetInfo *net) const
+{
+    if (net == nullptr || net->driver.cell == nullptr)
+        return false;
+    IdString dt = net->driver.cell->type;
+    return (dt == id_BUFGCTRL || dt == id_BUFCE_BUFG_PS || dt == id_BUFCE_BUFCE ||
+            dt == id_BUFGCE_DIV_BUFGCE_DIV) &&
+           net->driver.port == id_O;
+}
