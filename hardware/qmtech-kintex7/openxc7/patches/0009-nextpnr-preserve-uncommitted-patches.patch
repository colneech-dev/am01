From 846ac6a3acba52296525f5f69c777d056dc15455 Mon Sep 17 00:00:00 2001
From: colneech-dev <colneech@gmail.com>
Date: Thu, 3 Sep 2026 00:27:36 +0100
Subject: [PATCH 2/4] Preserve pre-existing uncommitted AM01 patches before
 congestion work

SMALL_BETA density target for <4-bel tiles, the congestion-map strtof
parse fix (atoi collapsed the float map to a 0/1 mask), and the
arch/arch_place changes that were already built into the binary in use
(built Aug 25, sources Aug 24). Committed unchanged, as a base to build
on rather than silently carrying dirty state into new work.
---
 common/placer_heap.cc | 30 ++++++++++++++++++++++++++++--
 common/router2.cc     | 29 +++++++++++++++++++++++++++--
 xilinx/arch.cc        | 35 +++++++++++++++++++++++++++++++----
 xilinx/arch_place.cc  | 35 +++++++++++++++++++++++++++++++++--
 4 files changed, 119 insertions(+), 10 deletions(-)

diff --git a/common/placer_heap.cc b/common/placer_heap.cc
index f21a9fe0..9e565dc2 100644
--- a/common/placer_heap.cc
+++ b/common/placer_heap.cc
@@ -1282,7 +1282,10 @@ class HeAPPlacer
                                         std::istringstream ss(line);
                                         while (std::getline(ss, cell, ','))
                                             if (!cell.empty())
-                                                row.push_back(atoi(cell.c_str()));
+                                                // The writer accumulates floats; atoi() truncated fractional
+                                        // values to 0 and parsed 1.23457e+06 as 1,
+                                        // collapsing the map to a 0/1 mask.
+                                        row.push_back(strtof(cell.c_str(), nullptr));
                                         m.push_back(row);
                                     }
                                     log_info("NEXTPNR_CONGESTION_MAP: loaded %d rows from %s\n", int(m.size()), f);
@@ -1479,10 +1482,33 @@ class HeAPPlacer
         std::vector<int> cells, bels;
         bool overused(float beta) const
         {
+            // AM01/openXC7 (env NEXTPNR_SMALL_BETA=<f>): density target for
+            // tiles with fewer than 4 bels.
+            //
+            // The `bels < 4` branch below bypasses beta entirely, so a BRAM
+            // tile -- 2 RAMB18E1 bels -- has an effective density target of
+            // 100% at EVERY value of beta. Block RAM is packed to full density
+            // in whichever columns the solver favoured and never relaxes, and
+            // no amount of beta tuning touches it.
+            //
+            // On this design that is the shape of the measured critical path:
+            // a BRAM output reaching its consumer LUT across (19,343) ->
+            // (50,151), 8.8 ns on one net. With 420 RAMB18E1 against 445 BRAM
+            // tiles there is room to spread to one per tile.
+            //
+            // Unset leaves the strict-overflow behaviour bit-identical.
+            static const float small_beta = []{
+                const char *e = getenv("NEXTPNR_SMALL_BETA");
+                return e ? float(atof(e)) : 0.0f;
+            }();
             for (size_t t = 0; t < cells.size(); t++) {
                 if (bels.at(t) < 4) {
-                    if (cells.at(t) > bels.at(t))
+                    if (small_beta > 0.0f) {
+                        if (cells.at(t) > small_beta * bels.at(t))
+                            return true;
+                    } else if (cells.at(t) > bels.at(t)) {
                         return true;
+                    }
                 } else {
                     if (cells.at(t) > beta * bels.at(t))
                         return true;
