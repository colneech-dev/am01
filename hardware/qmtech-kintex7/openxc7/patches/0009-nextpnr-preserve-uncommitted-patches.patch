+        {
             for (size_t n = 0; n < nets.size(); n++) {
                 // Constant nets are deliberately left unrouted by router2 -- they
                 // are excluded from route_queue at setup and from
@@ -1643,7 +1660,7 @@ struct Router2
                         ++unrouted_arcs;
                         any_unrouted = true;
                     }
-                if (any_unrouted)
+                if (any_unrouted && requeue_unrouted)
                     failed_nets.insert(int(n));
             }
         }
@@ -2282,6 +2299,14 @@ struct Router2
             log_info("    iter=%d wires=%d overused=%d overuse=%d unrouted=%d archfail=%s\n", iter, total_wire_use,
                      overused_wires, total_overuse, unrouted_arcs,
                      overused_wires > 0 ? "NA" : std::to_string(arch_fail).c_str());
+            // Export per-tile congestion on a CONVERGED iteration too, not only
+            // from the SKIP_FAILED_ARCS abort path. Seeding a placement from a
