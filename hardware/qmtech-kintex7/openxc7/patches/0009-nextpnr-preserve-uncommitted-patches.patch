diff --git a/xilinx/arch.cc b/xilinx/arch.cc
index 410d3c32..8684ca77 100644
--- a/xilinx/arch.cc
+++ b/xilinx/arch.cc
@@ -648,6 +648,25 @@ std::vector<std::pair<IdString, std::string>> Arch::getBelAttrs(BelId bel) const
 
 // -----------------------------------------------------------------------
 
+
+// AM01/openXC7 (env NEXTPNR_LINEAR_DELAY=1): drop the concave second segment
+// of the distance->delay model, so marginal cost per tile is constant.
+//
+// The stock model charges 30/tile for the first 18 x-tiles and 10/tile beyond,
+// 60/tile for the first 6 y-tiles and 20/tile beyond. Measured against Vivado
+// on this design, the true rate is ~99 ps/tile and essentially flat, so the
+// stock model is 3.3x (y) to 6.6x (x) under at the margin -- and OVER-charges
+// below ~13 tiles, i.e. the error changes sign.
+//
+// Criticality is scale-invariant (timing.cc:678-680), so only the shape of
+// this curve reaches the placer. A concave curve tells the placer that pulling
+// an already-distant critical net closer buys almost nothing.
+static inline bool nextpnr_linear_delay()
+{
+    static const bool v = getenv("NEXTPNR_LINEAR_DELAY") != nullptr;
+    return v;
+}
+
 delay_t Arch::estimateDelay(WireId src, WireId dst, bool debug) const
 {
     if (src == dst)
@@ -752,8 +771,12 @@ delay_t Arch::estimateDelay(WireId src, WireId dst, bool debug) const
     // greedy best-first and biases it against vertical long lines.
     static const bool iso_h = getenv("NEXTPNR_ISO_HEURISTIC") != nullptr;
     const int yc1 = iso_h ? 30 : 60, yc2 = iso_h ? 10 : 20;
-    delay_t base = 30 * std::min(std::abs(dst_x - src_x), 18) + 10 * std::max(std::abs(dst_x - src_x) - 18, 0) +
-                   yc1 * std::min(std::abs(dst_y - src_y), 6) + yc2 * std::max(std::abs(dst_y - src_y) - 6, 0) + 300;
+    delay_t base;
+    if (nextpnr_linear_delay())
+        base = 30 * std::abs(dst_x - src_x) + yc1 * std::abs(dst_y - src_y) + 300;
+    else
+        base = 30 * std::min(std::abs(dst_x - src_x), 18) + 10 * std::max(std::abs(dst_x - src_x) - 18, 0) +
+               yc1 * std::min(std::abs(dst_y - src_y), 6) + yc2 * std::max(std::abs(dst_y - src_y) - 6, 0) + 300;
 
     if (xc7)
         base = (base * 3) / 2;
@@ -852,8 +875,12 @@ delay_t Arch::predictDelay(const NetInfo *net_info, const PortRef &sink) const
         // and the search heuristic disagree about the same distance.
         static const bool iso_h2 = getenv("NEXTPNR_ISO_HEURISTIC") != nullptr;
         const int pyc1 = iso_h2 ? 30 : 60, pyc2 = iso_h2 ? 10 : 20;
-        delay_t base = 30 * std::min(std::abs(dst_x - src_x), 18) + 10 * std::max(std::abs(dst_x - src_x) - 18, 0) +
-                       pyc1 * std::min(std::abs(dst_y - src_y), 6) + pyc2 * std::max(std::abs(dst_y - src_y) - 6, 0) + 300;
+        delay_t base;
+        if (nextpnr_linear_delay())
+            base = 30 * std::abs(dst_x - src_x) + pyc1 * std::abs(dst_y - src_y) + 300;
+        else
+            base = 30 * std::min(std::abs(dst_x - src_x), 18) + 10 * std::max(std::abs(dst_x - src_x) - 18, 0) +
+                   pyc1 * std::min(std::abs(dst_y - src_y), 6) + pyc2 * std::max(std::abs(dst_y - src_y) - 6, 0) + 300;
 
         if (xc7)
             base = (base * 3) / 2;
diff --git a/xilinx/arch_place.cc b/xilinx/arch_place.cc
